{
  "name": "spaper",
  "version": "2.0.0",
  "description": "PapierCSS components for Svelte",
  "keywords": [
    "components",
    "papercss",
    "papiercss",
    "svelte",
    "sveltejs",
    "tailwind"
  ],
  "homepage": "https://github.com/Oli8/spaper#readme",
  "bugs": {
    "url": "https://github.com/Oli8/spaper/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oli8/spaper.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#docs/*": "./src/docs/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@sketchyicons/svelte": "^0.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "papiercss": "^1.0.2",
    "publint": "^0.3.0",
    "shiki": "^4.4.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "peerDependencies": {
    "papiercss": "^1.0.2",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.0.0"
  }
}
